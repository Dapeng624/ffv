# Keep this file as a template. Put real secrets in `.env.local` only.
VIDEO_PROVIDER=seedance
ARK_API_KEY=replace-with-your-volcengine-ark-api-key

# Copy the exact Seedance Model ID or Endpoint ID shown in the Ark console.
ARK_VIDEO_MODEL=replace-with-model-or-endpoint-id
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_RESOLUTION=720p
ARK_GENERATE_AUDIO=false
ARK_WATERMARK=false

# Seedance must be able to fetch uploaded reference media from this address.
# Localhost will not work for real generation; use the deployed public origin.
PUBLIC_APP_URL=https://replace-with-your-public-site.example
ASSET_SIGNING_SECRET=replace-with-a-long-random-secret

# Stripe payments. Use test keys locally, live keys in production.
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-stripe-webhook-secret
STRIPE_MONTHLY_PRICE_ID=price_replace-with-monthly-price-id
STRIPE_YEARLY_PRICE_ID=price_replace-with-yearly-price-id

# Optional: use a public R2/custom-domain base URL instead of signed app URLs.
# MEDIA_PUBLIC_BASE_URL=https://media.example.com

# Cloudflare Git build variables. The D1 ID is visible on the D1 database page.
YINGZO_D1_DATABASE_ID=replace-with-cloudflare-d1-database-uuid
YINGZO_D1_DATABASE_NAME=site-creator-d1
YINGZO_R2_BUCKET_NAME=site-creator-r2
